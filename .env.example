# Example environment variables for Next-to-me

# Mode
LIVE_MODE=False
LIVE_CONFIRM=NO  # must be set to YES to enable live trading

# Account / credentials (for live)
MT5_LOGIN=
MT5_PASS=
MT5_SERVER=

# Strategy / runtime
SYMBOL=EURUSD
TIMEFRAME=15m
DATA_PATH=dummy_data.csv
INITIAL_BALANCE=10000
RISK_PERCENT=0.02

# Logging / runs
LOG_DIR=logs
DATA_DIR=data
#.env
API_KEY=
API_SECRET=
LIVE_MODE=False
RISK_PERCENT=0.02
SYMBOL=EURUSD
TIMEFRAME=15m
LOG_DIR=logs
